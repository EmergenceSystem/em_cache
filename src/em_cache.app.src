{application, em_cache, [
    {description, "Two-tier (ETS + optional Redis) query result cache for Emergence"},
    {vsn, "0.2.0"},
    {registered, [em_cache_sup, em_cache_store]},
    {mod, {em_cache_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        cowboy,
        eredis
    ]},
    {env, [
        {port, 8300},
        {redis_host, "127.0.0.1"},
        {redis_port, 6379},
        {ttl, 3600}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/em_cache"}]}
]}.
